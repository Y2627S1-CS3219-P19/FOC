{
  "name": "user-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FoC User Service - profiles, RBAC admin workflows and Keycloak integration",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@foc/shared-events": "*",
    "@foc/shared-middleware": "*",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
