# Copy to terraform.tfvars (gitignored) and fill in. No secrets go in this file.

# Keycloak's emails are sent through Gmail SMTP from this address (it must be the Gmail account that
# owns the app password given to put-secrets.ps1).
email_from_address = "someone@gmail.com"

alert_email = "e0000001@u.nus.edu"

# Teammates' own NUS sandbox account IDs: they get a read-only "switch role" (team-access.tf).
# Each runs `aws sts get-caller-identity --query Account --output text` in their own account.
team_account_ids = []
