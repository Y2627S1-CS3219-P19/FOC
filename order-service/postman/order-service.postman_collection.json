  "item": [
    {
      "name": "0. Log in",
      "item": [
        {
          "name": "Login as requester",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{keycloakUrl}}/realms/campuserrand/protocol/openid-connect/token"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "campuserrand-test"
                },
                {
                  "key": "username",
                  "value": "{{requesterUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{requesterPassword}}"
                }
              ]
            },
            "description": "Gets an access token for the requester and saves requesterToken and requesterId (the token's sub)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().access_token;",
                  "pm.collectionVariables.set('requesterToken', token);",
                  "const part = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "pm.collectionVariables.set('requesterId', JSON.parse(atob(part)).sub);"
                ]
              }
            }
          ]
        },
