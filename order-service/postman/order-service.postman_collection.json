    {
      "name": "7. Errors",
      "item": [
        {
          "name": "No token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/orders"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('error TOKEN_MISSING', () => pm.expect(pm.response.json().error.code).to.eql('TOKEN_MISSING'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Bad input -> 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{requesterToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/orders"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierId\": \"not-a-uuid\",\n  \"items\": [],\n  \"creditAmount\": 0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));",
                  "pm.test('error VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Expiry more than 24h away -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{requesterToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/orders"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierId\": \"{{supplierId}}\",\n  \"deliveryLocation\": \"COM1 lobby\",\n  \"items\": [\n    \"1x chicken rice\",\n    \"1x iced milo\"\n  ],\n  \"creditAmount\": 5,\n  \"expiresAt\": \"{{farExpiresAt}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('farExpiresAt', new Date(Date.now() + 25 * 3600 * 1000).toISOString());"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error EXPIRY_TOO_FAR', () => pm.expect(pm.response.json().error.code).to.eql('EXPIRY_TOO_FAR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown order -> 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{requesterToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/orders/00000000-0000-4000-8000-000000000000"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error ORDER_NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('ORDER_NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Completed order hidden from strangers -> 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherRunnerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/orders/{{orderId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 403', () => pm.response.to.have.status(403));",
                  "pm.test('error NOT_ORDER_PARTICIPANT', () => pm.expect(pm.response.json().error.code).to.eql('NOT_ORDER_PARTICIPANT'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
