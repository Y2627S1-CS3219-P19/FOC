    {
      "name": "1. Pick a supplier",
      "item": [
        {
          "name": "List suppliers open now",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{requesterToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/suppliers?status=open_now&limit=5"
            },
            "description": "Supplier Service. Saves the first open supplier as supplierId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const first = pm.response.json().data[0];",
                  "pm.test('a supplier is open now', () => pm.expect(first).to.be.an('object'));",
                  "pm.collectionVariables.set('supplierId', first.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Create and read",
      "item": [
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{requesterToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/orders"
            },
            "description": "Returns 202 with a PENDING order. Credit Service replies through RabbitMQ; then the order is OPEN or REJECTED. ",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierId\": \"{{supplierId}}\",\n  \"deliveryLocation\": \"COM1 lobby\",\n  \"items\": [\n    \"1x chicken rice\",\n    \"1x iced milo\"\n  ],\n  \"creditAmount\": 5,\n  \"expiresAt\": \"{{expiresAt}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('expiresAt', new Date(Date.now() + 2 * 3600 * 1000).toISOString());"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 202', () => pm.response.to.have.status(202));",
                  "const order = pm.response.json().data;",
                  "pm.test('starts PENDING', () => pm.expect(order.status).to.eql('PENDING'));",
                  "pm.collectionVariables.set('orderId', order.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order (wait until OPEN)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{requesterToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/orders/{{orderId}}"
            },
            "description": "Polls until Credit Service has answered. Shows the requester and runner summaries from the User Service."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const order = pm.response.json().data;",
                  "if (order.status === 'PENDING') {",
                  "  // Credit has not replied yet: try again in 1s (Collection Runner only).",
                  "  setTimeout(() => {}, 1000);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.test('is OPEN', () => pm.expect(order.status).to.eql('OPEN'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Timeline (requester)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{requesterToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/orders/{{orderId}}/timeline"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Mine as requester",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{requesterToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/orders/mine?as=requester"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
