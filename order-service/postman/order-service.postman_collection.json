              {
                "key": "Authorization",
                "value": "Bearer {{runnerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/orders/{{orderId}}/timeline"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Withdraw and cancel",
      "item": [
        {
          "name": "Create order to withdraw and cancel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{requesterToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/orders"
            },
            "description": "Returns 202 with a PENDING order. Credit Service replies through RabbitMQ; then the order is OPEN or REJECTED. ",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierId\": \"{{supplierId}}\",\n  \"deliveryLocation\": \"COM1 lobby\",\n  \"items\": [\n    \"1x chicken rice\",\n    \"1x iced milo\"\n  ],\n  \"creditAmount\": 5,\n  \"expiresAt\": \"{{expiresAt}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('expiresAt', new Date(Date.now() + 2 * 3600 * 1000).toISOString());"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 202', () => pm.response.to.have.status(202));",
                  "const order = pm.response.json().data;",
                  "pm.test('starts PENDING', () => pm.expect(order.status).to.eql('PENDING'));",
                  "pm.collectionVariables.set('cancelOrderId', order.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order (wait until OPEN)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{requesterToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/orders/{{cancelOrderId}}"
            },
            "description": "Polls until Credit Service has answered. Shows the requester and runner summaries from the User Service."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const order = pm.response.json().data;",
                  "if (order.status === 'PENDING') {",
                  "  // Credit has not replied yet: try again in 1s (Collection Runner only).",
                  "  setTimeout(() => {}, 1000);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.test('is OPEN', () => pm.expect(order.status).to.eql('OPEN'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Accept (runner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{runnerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/orders/{{cancelOrderId}}/accept"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('now ACCEPTED', () => pm.expect(pm.response.json().data.status).to.eql('ACCEPTED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Requester cancels after accept -> 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{requesterToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/orders/{{cancelOrderId}}/cancel"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('error ILLEGAL_TRANSITION', () => pm.expect(pm.response.json().error.code).to.eql('ILLEGAL_TRANSITION'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Withdraw (runner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{runnerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/orders/{{cancelOrderId}}/withdraw"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('now OPEN', () => pm.expect(pm.response.json().data.status).to.eql('OPEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel (requester)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{requesterToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/orders/{{cancelOrderId}}/cancel"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('now CANCELLED', () => pm.expect(pm.response.json().data.status).to.eql('CANCELLED'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Admin",
      "item": [
        {
          "name": "Orders of a user (admin)",
          "request": {
            "method": "GET",
