{
  "name": "order-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FoC Order Service - errand orders and their lifecycle",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "docs:transitions": "tsx src/scripts/transitionsDoc.ts",
    "mock:credit": "tsx mocks/credit-mock.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@foc/shared-events": "*",
    "@foc/shared-middleware": "*",
    "amqplib": "^0.10.8",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.6.2",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
