# Order Service environment. In Docker these come from compose (see snippets/compose.order.yaml).
# For `npm run dev` outside Docker, copy this to order-service/.env and export it (e.g. `set -a; . ./.env; set +a`).
# Never commit real secrets.

PORT=3004
LOG_LEVEL=info
DATABASE_URL=postgres://orders:change-me-orders-db@localhost:5436/orders_db

# Keycloak: tokens are verified with the internal URL's keys and must carry iss = public URL.
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=campuserrand
ALLOWED_TOKEN_CLIENTS=campuserrand-spa,campuserrand-test

# Other services (internal routes, called with X-Internal-Auth).
USER_SERVICE_URL=http://localhost:3001
SUPPLIER_SERVICE_URL=http://localhost:3002
INTERNAL_AUTH_SECRET=change-me-internal-secret
HTTP_TIMEOUT_MS=3000

# RabbitMQ. Leave empty to run without it: events stay in the outbox, credit replies are not consumed.
AMQP_URL=amqp://foc:change-me-rabbitmq@localhost:5672
DEBUG_EVENT_QUEUE=false
CONSUMER_RETRY_DELAY_MS=5000

# Jobs
EXPIRY_SWEEP_MS=30000
AUTO_CONFIRM_AFTER_HOURS=24
PENDING_TIMEOUT_SECONDS=120

TRUST_PROXY=
