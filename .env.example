# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# Values marked (per machine) can differ between teammates, because
# everyone runs their own local Keycloak/Postgres. Nothing here needs
# to match anyone else's .env.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=info

# ---- Databases (per machine) --------------------------------
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
USERS_DB_PASSWORD=change-me-users-db
SUPPLIERS_DB_PASSWORD=change-me-suppliers-db

# ---- Keycloak -----------------------------------------------
# Login for the Keycloak admin console at http://localhost:8080 (per machine).
# This is Keycloak's own operator account, NOT the FoC app admin. Only used on first start.
KC_BOOTSTRAP_ADMIN_USERNAME=kc-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-kc-admin
# Secret of the `user-service` Keycloak client. Injected into the realm import AND the User Service,
# so both sides always match. Changing it later requires recreating the Keycloak volume.
KC_USER_SERVICE_CLIENT_SECRET=change-me-client-secret

# ---- Service-to-service auth --------------------------------
# Shared secret sent as X-Internal-Auth on /v1/internal/* calls.
INTERNAL_AUTH_SECRET=change-me-internal-secret

# ---- User Service rules -------------------------------------
# Only @u.nus.edu is approved. Keycloak also enforces this pattern.
ALLOWED_EMAIL_DOMAINS=u.nus.edu
# Shown to suspended users (F3.1.4.1).
ADMIN_CONTACT_EMAIL=foc-admin@u.nus.edu
# F1.1.4: account creations per IP per hour.
REGISTER_RATE_LIMIT_PER_HOUR=5

# ---- First FoC admin (startup bootstrap, F29.3) -------------
# Created once on first start, then a permanent flag stops it running again.
# The temporary password must meet the password policy and is changed on first login.
# Clear these values after the first successful start.
BOOTSTRAP_ADMIN_EMAIL=your-nusnet-id@u.nus.edu
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_TEMP_PASSWORD=ChangeMe123

# ---- RabbitMQ -----------------------------------------------
RABBITMQ_USER=foc
RABBITMQ_PASSWORD=change-me-rabbitmq
# Adds a dev-only queue bound to every event so you can inspect messages in the RabbitMQ UI.
DEBUG_EVENT_QUEUE=true
